# Data Reconciliation Environment Configuration
# Copy this file to .env and customize for your deployment

# Database Configuration (READ-ONLY recommended)
PG_URL=postgres://username:password@hostname:5432/database_name

# API Configuration
BASE_URL=https://api.charged.autos
ADMIN_TOKEN_PROD_TEST=your_admin_jwt_token_here

# Timezone Configuration
TZ_AUDIT=America/Halifax

# Safety Configuration
CONFIRM_APPLY=0
