{
  "name": "charged-admin",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.14.19",
    "@mui/material": "^5.14.19",
    "@types/node": "^16.18.65",
    "@types/react": "^18.2.38",
    "@types/react-dom": "^18.2.17",
    "axios": "^1.6.2",
    "chart.js": "^4.4.0",
    "firebase": "^10.14.1",
    "firebase-admin": "^13.2.0",
    "lucide-react": "^0.503.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^6.20.0",
    "react-scripts": "5.0.1",
    "typescript": "^5.0.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --coverageReporters=text --coverageReporters=lcov",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "perf": "playwright test -g '@perf'",
    "contract": "playwright test tests/api/contract.test.ts",
    "precommit": "npm run lint && npm run typecheck && npm run test:cov",
    "predeploy:verify": "npm run lint && npm run typecheck && npm run test:cov && npm run e2e && npm run contract && npm run a11y && npm run perf",
    "eject": "react-scripts eject",
    "format": "prettier --write .",
    "cleanup:test-artifacts": "rm -rf coverage/ test-report/ playwright-report/ test-results/ traces/ screenshots/",
    "fetch:openapi": "ts-node scripts/dev/fetch-openapi.ts",
    "gen:endpoints": "ts-node scripts/dev/generate-endpoints.ts",
    "diff:endpoints": "ts-node scripts/dev/diff-endpoints.ts",
    "bundle:endpoints": "ts-node scripts/dev/make-server-bundles.ts",
    "endpoints:refresh": "ts-node scripts/dev/run-all.ts",
    "db:migrate": "ts-node scripts/db/migrate.ts",
    "db:rollback": "ts-node scripts/db/rollback.ts",
    "db:verify": "ts-node scripts/db/verify.ts",
    "prod:contract": "jest --config tests/prod/jest.contract.config.js",
    "prod:smoke": "playwright test -c tests/prod/playwright.config.ts --project=chromium",
    "prod:ui:a11y": "echo 'Accessibility testing disabled'",
    "prod:report:bundle": "node tests/prod/scripts/bundle-reports.js",
    "prod:state:generate": "node tests/prod/scripts/generate-admin-state.js",
    "prod:test": "node tests/prod/scripts/run-production-tests.js",
    "api:docs:fetch": "ts-node --project tsconfig.scripts.json scripts/openapi/fetch-current.ts",
    "api:docs:scan": "ts-node --project tsconfig.scripts.json scripts/openapi/scan-code.ts",
    "api:docs:seed": "ts-node --project tsconfig.scripts.json scripts/openapi/seed-templates.ts",
    "api:docs:merge": "ts-node --project tsconfig.scripts.json scripts/openapi/merge.ts",
    "api:docs:validate": "ts-node --project tsconfig.scripts.json scripts/openapi/validate.ts",
    "api:docs:diff": "ts-node --project tsconfig.scripts.json scripts/openapi/diff-report.ts",
    "api:docs:bundle": "ts-node --project tsconfig.scripts.json scripts/openapi/bundle-docs.ts",
    "api:docs:all": "npm run api:docs:fetch && npm run api:docs:scan && npm run api:docs:seed && npm run api:docs:merge && npm run api:docs:validate && npm run api:docs:diff && npm run api:docs:bundle",
    "api:docs:fix:paths": "node scripts/openapi/fix-path-format.cjs",
    "api:docs:fix:opids": "node scripts/openapi/fix-operation-ids.cjs",
    "api:docs:fix:schemas": "node scripts/openapi/fill-min-schemas.cjs",
    "api:docs:fix:params": "node scripts/openapi/normalize-params.cjs",
    "api:docs:fix:dedupe": "node scripts/openapi/dedupe-schemas.cjs",
    "api:docs:fix:stdres": "node scripts/openapi/add-standard-responses.cjs",
    "api:docs:stamp": "node scripts/openapi/stamp-metadata.cjs",
    "api:docs:bundle:rc": "node scripts/openapi/bundle-rc.cjs",
    "api:docs:rc": "npm run api:docs:merge && npm run api:docs:fix:paths && npm run api:docs:fix:opids && npm run api:docs:fix:schemas && npm run api:docs:fix:params && npm run api:docs:fix:dedupe && npm run api:docs:fix:stdres && npm run api:docs:stamp && npm run api:docs:bundle:rc",
    "api:docs:rc:validate": "npm run api:docs:merge && npm run api:docs:fix:paths && npm run api:docs:fix:opids && npm run api:docs:fix:schemas && npm run api:docs:fix:params && npm run api:docs:fix:dedupe && npm run api:docs:fix:stdres && npm run api:docs:validate && npm run api:docs:stamp && npm run api:docs:bundle:rc"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.0.0",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@stoplight/spectral-cli": "^6.15.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/archiver": "^6.0.3",
    "@types/jest": "^30.0.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "archiver": "^7.0.1",
    "deepmerge": "^4.3.1",
    "fast-glob": "^3.3.3",
    "glob": "^10.3.10",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-extended": "^6.0.0",
    "jest-html-reporters": "^3.1.7",
    "jest-transform-stub": "^2.0.0",
    "msw": "^2.11.2",
    "openapi-to-postmanv2": "^5.1.0",
    "pg": "^8.16.3",
    "prettier": "3.5.3",
    "redoc-cli": "^0.13.21",
    "supertest": "^7.1.4",
    "swagger-ui-dist": "^5.9.0",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "yaml": "^2.8.1"
  }
}
