{
  "name": "charged-admin",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.14.19",
    "@mui/material": "^5.14.19",
    "@types/node": "^16.18.65",
    "@types/react": "^18.2.38",
    "@types/react-dom": "^18.2.17",
    "axios": "^1.6.2",
    "chart.js": "^4.4.0",
    "firebase": "^10.14.1",
    "firebase-admin": "^13.2.0",
    "lucide-react": "^0.503.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^6.20.0",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --coverageReporters=text --coverageReporters=lcov",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "perf": "playwright test -g '@perf'",
    "contract": "playwright test tests/api/contract.test.ts",
    "precommit": "npm run lint && npm run typecheck && npm run test:cov",
    "predeploy:verify": "npm run lint && npm run typecheck && npm run test:cov && npm run e2e && npm run contract && npm run a11y && npm run perf",
    "eject": "react-scripts eject",
    "format": "prettier --write .",
    "cleanup:test-artifacts": "rm -rf coverage/ test-report/ playwright-report/ test-results/ traces/ screenshots/",
    "fetch:openapi": "ts-node scripts/dev/fetch-openapi.ts",
    "gen:endpoints": "ts-node scripts/dev/generate-endpoints.ts",
    "diff:endpoints": "ts-node scripts/dev/diff-endpoints.ts",
    "bundle:endpoints": "ts-node scripts/dev/make-server-bundles.ts",
    "endpoints:refresh": "ts-node scripts/dev/run-all.ts"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.0.0",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/archiver": "^6.0.3",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^6.0.3",
    "archiver": "^7.0.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-extended": "^6.0.0",
    "jest-transform-stub": "^2.0.0",
    "msw": "^2.11.2",
    "openapi-to-postmanv2": "^5.1.0",
    "prettier": "3.5.3",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2"
  }
}
