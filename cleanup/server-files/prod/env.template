# Production Test Environment Variables
# Copy this file to .env.prod-test and fill in the actual values
# DO NOT COMMIT .env.prod-test to version control

# Production API Configuration
BASE_URL=https://api.charged.autos
WS_URL=wss://api.charged.autos/realtime
ADMIN_DASHBOARD_URL=https://admin.charged.autos

# Test Authentication (REQUIRED)
# Get this from your admin account in production
ADMIN_TOKEN_PROD_TEST=your_jwt_token_here

# Test Tenant Configuration (REQUIRED)
# Create a dedicated test organization in production
ORG_TEST_ID=your_test_org_uuid_here

# Test User IDs (OPTIONAL - for endpoints requiring specific user IDs)
RIDER_TEST_ID=your_test_rider_uuid_here
DRIVER_TEST_ID=your_test_driver_uuid_here

# Test Safety Configuration
MAX_CONCURRENT_REQUESTS=3
REQUEST_TIMEOUT=30000
CLEANUP_TIMEOUT=60000
